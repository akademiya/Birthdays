<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:background="@drawable/bg_toolbar"
        android:scaleType="centerCrop" />

    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_border"
        android:layout_above="@+id/shareButton"
        android:padding="3dp"
        android:translationZ="999dp">

        <ImageView
            android:id="@+id/cardBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="centerCrop" />

    </FrameLayout>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        android:layout_above="@+id/menuContainer"
        android:layout_toStartOf="@+id/shareButton"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-5169531562006723/5803336498" />

    <ImageView
        android:id="@+id/shareButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginVertical="20dp"
        android:layout_above="@+id/menuContainer"
        android:layout_alignParentEnd="true"
        android:padding="4dp"
        app:tint="@color/color_search_bg"
        android:src="@drawable/share" />

    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/childImageGifts"
            android:layout_width="match_parent"
            android:background="@color/bg_girl"
            tools:listitem="@layout/item_gift_menu"
            android:layout_height="60dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/parentImageGifts"
            android:layout_width="match_parent"
            android:background="@drawable/bg_toolbar"
            tools:listitem="@layout/item_gift_menu"
            android:layout_height="60dp" />
    </LinearLayout>
</RelativeLayout>
